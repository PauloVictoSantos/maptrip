# Copie para .env e preencha. Nunca faça commit do .env.

# MongoDB (obrigatório) — usuário e senha vão dentro da URI
MONGODB_URI="mongodb+srv://USUARIO:SENHA@cluster.exemplo.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="maptrip"

# Sessão (obrigatório) — pelo menos 32 caracteres aleatórios
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# URL pública do app (links de e-mail e retorno do Google)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Login com Google (opcional) — Google Cloud Console > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# E-mail de redefinição de senha (opcional) — https://resend.com
# Sem isso, em desenvolvimento o link aparece no terminal do `npm run dev`.
RESEND_API_KEY=""
EMAIL_FROM="MapTrip <nao-responda@seu-dominio.com>"
